    "tauri": "tauri",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/svg-icons": "^1.1.347",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.3"
  }
}
