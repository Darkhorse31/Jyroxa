{
  "name": "jyroxa-desktop",
  "private": true,
  "version": "0.1.11",
  "author": "Prateek Kumar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-contract.mjs",
    "lint": "eslint src",
    "test": "node --test scripts/design-unit.test.mjs",
    "test:design": "node scripts/design-v3-verify.mjs",
    "brand:design": "node scripts/generate-design-brand.mjs && node scripts/generate-fluent-icons.mjs",
    "build": "npm run check && tsc && vite build",
