{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jyroxa",
  "version": "0.1.13",
  "identifier": "com.jyroxa.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:windows",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jyroxa",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Prateek Kumar",
    "targets": ["nsis"],
    "resources": {
      "WebView2Loader.dll": "./",
      "jyroxa-native-host.exe": "./jyroxa-native-host.exe",
      "jyroxa-browser-register.exe": "./jyroxa-browser-register.exe",
      "jyroxa.exe": "./jyroxa.exe",
      "yt-dlp.exe": "./yt-dlp.exe",
      "ffmpeg.exe": "./ffmpeg.exe",
      "node.exe": "./node.exe",
      "node-LICENSE.txt": "./node-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerHooks": "./windows/browser-installer.nsh"
      }
    }
  }
}
