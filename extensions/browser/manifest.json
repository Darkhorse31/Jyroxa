{
  "manifest_version": 3,
  "name": "Jyroxa Download Integration",
  "version": "0.1.2",
  "description": "Capture browser downloads and send them to Jyroxa.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Jyroxa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "downloads.shelf",
    "contextMenus",
    "cookies",
    "storage",
    "nativeMessaging",
    "notifications",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "jyroxa-browser@jyroxa",
      "strict_min_version": "109.0"
    }
  }
}
